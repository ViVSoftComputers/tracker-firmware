         }
         LOG_INFO("CachedPhoneTracker: Tracker Mode ON (1 pt/min)\n");
     } else {
         digitalWrite(PIN_LED1, !LED_STATE_ON);
-        play4ClickDown();
+        playTrackerChime(false);
         LOG_INFO("CachedPhoneTracker: Tracker Mode OFF (cache preserved)\n");
     }
 }
